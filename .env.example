# 默认只监听服务器回环地址，交给 Caddy/Nginx 反向代理。
BIND_ADDRESS=127.0.0.1
APP_PORT=5001

# 单个 HTTP 请求的总大小上限（MB）。多文件转换时是所有文件之和。
MAX_UPLOAD_MB=50

# 单次转换文件数量，以及解码后的单图/总像素上限。
MAX_FILES_PER_JOB=10
MAX_IMAGE_PIXELS=40000000
MAX_TOTAL_PIXELS=100000000

# 每个 Gunicorn worker 同时处理的任务数，以及每个来源 IP 的短窗口任务额度。
PROCESSING_CONCURRENCY=2
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# 结果默认保留 1 小时；容器后台每 10 分钟回收过期任务。
FILE_RETENTION_HOURS=1
ARTIFACT_CLEANUP_INTERVAL_SECONDS=600

# Compose 默认仅绑定 127.0.0.1，并由本机 Caddy 转发，因此信任最后一跳代理头。
# 如果把容器端口直接暴露公网，必须改为 false。
TRUST_PROXY_HEADERS=true

# 图片处理较耗内存，低配服务器建议保持 2 x 2 或调成 1 x 2。
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
